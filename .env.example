POSTGRES_USER=guguinha
POSTGRES_PASSWORD=guguinha
POSTGRES_DB=guguinha
DATABASE_URL=postgres://guguinha:guguinha@localhost:5432/guguinha?sslmode=disable
PORT=8080

# Required: random secret for signing pending registrations (generate with: openssl rand -hex 32)
AUTH_SECRET=troque-por-um-segredo-forte

# Google OAuth (optional — leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost

# Cloudflare R2 (optional — leave empty to disable thumbnail upload)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Resend (optional — leave empty to disable password-reset emails)
RESEND_API_KEY=
RESEND_FROM=noreply@localhost
